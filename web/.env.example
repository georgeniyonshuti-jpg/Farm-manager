# Omit VITE_API_URL for local dev/preview so the app uses `/api` (Vite proxies to the backend).
# Set it for production builds when the API is on a different host than the static UI.
# VITE_API_URL=https://farmapi.clevacredit.com
VITE_APP_VERSION=1.0.0

# Optional Stripe (server-side keys on Render — never put secrets in VITE_*)

# Public Cleva WhatsApp (digits or +250…). Used if /api/market/board has no number.
# VITE_MARKET_WHATSAPP=250796683323

# Demo public board rate (RWF/kg) if Clevatech has not published a card yet.
# VITE_MARKET_STRIP_RATE=4300

# Optional public socials. Omit both to hide the row — do not invent handles.
# VITE_MARKET_INSTAGRAM=
# VITE_MARKET_FACEBOOK=

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...

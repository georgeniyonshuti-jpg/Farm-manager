DATABASE_URL=

# Stripe billing (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# FRONTEND_URL=https://your-app.vercel.app
ENABLE_DEMO_USERS=false
SESSION_SECRET=
GEMINI_API_KEY=
NODE_ENV=production
FRONTEND_URL=https://farm.cleva.rw
PORT=3000
APP_VERSION=1.0.0
RENDER_EXTERNAL_URL=https://farmapi.cleva.rw
INTERNAL_API_SECRET=replace-with-strong-internal-secret
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_DEFAULT_COST_CENTER=
ERPNEXT_WEBHOOK_SECRET=
ERPNEXT_OAUTH_CLIENT_ID=clevafarm
ERPNEXT_OAUTH_CLIENT_SECRET=
# Shared with ERPNext site_config clevafarm_api_secret (X-ClevaFarm-Secret header)
CLEVAFARM_API_SECRET=
# Login with Cleva (shared identity — separate OAuth Client "Cleva Farm")
CLEVA_SSO_ENABLED=false
CLEVA_OAUTH_CLIENT_ID=
CLEVA_OAUTH_CLIENT_SECRET=
# Must match ERPNext OAuth Client scopes exactly (default: all). Do not add openid.
CLEVA_OAUTH_SCOPE=all
# Optional endpoint overrides:
# CLEVA_OAUTH_AUTHORIZE_URL=
# CLEVA_OAUTH_USERINFO_URL=
# Continue with Cleva ERP (email → tenant):
# CLEVA_SAAS_LOOKUP_URL=https://admin.clevacredit.com
# CLEVA_SAAS_LOOKUP_SECRET=
# CLEVA_TENANT_BASE_DOMAIN=cleva.rw
# Optional Frappe multi-site bench
ERPNEXT_SITE=
ERPNEXT_SERVICE_ACCOUNT=farmapi@clevacredit.com

# Marketplace host tenant — from=market signups join this company, never default-farm.
# MARKET_HOST_COMPANY_ID=
# MARKET_HOST_COMPANY_SLUG=cleva-technologies
# Public board WhatsApp (digits or +250…). Guest FAB also has a client fallback.
# MARKET_WHATSAPP_NUMBER=250796683323

# Cloudinary (marketplace farm/lot photos)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=cleva-market

# Mail delivery (required for password reset emails)
SMTP_HOST=mail.clevagroup.africa
SMTP_PORT=587
SMTP_USER=no-reply@clevagroup.africa
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@clevagroup.africa
# SMTP_SECURE=true  # use only for port 465 / implicit TLS
